{
  "name": "data-extractor",
  "displayName": "Data Extractor",
  "description": "Map indicators and download routine data from DHIS2 to Excel, for the Countdown 2030 analyses or your own.",
  "publisher": "datasuite",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/damurka/data-extractor.git"
  },
  "engines": {
    "vscode": "^1.131.0"
  },
  "categories": [
    "Data Science"
  ],
  "enabledApiProposals": [
    "datasuiteDhis2"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dataExtractor.open",
        "title": "Open Data Extractor",
        "category": "DHIS2"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit && tsc -p ./src/webview --noEmit",
    "test": "tsc -p ./tsconfig.test.json && node --test \"out-test/test/**/*.test.js\"",
    "vscode:prepublish": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
